PORT=5000
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/
JWT_SECRET=replace_this_with_a_long_random_secret
CLIENT_ORIGIN=http://localhost:5173

# Used only by the seed script to create the admin account.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_this_with_a_strong_password

# Optional: only set this if MongoDB SRV lookups fail on your network.
# DNS_SERVERS=8.8.8.8,8.8.4.4
