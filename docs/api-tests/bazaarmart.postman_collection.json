      "value": "api.test@example.com"
    },
    {
      "key": "userPassword",
      "value": "secret123"
    },
    {
      "key": "adminEmail",
      "value": "admin@bazaarmart.com"
    },
    {
      "key": "adminPassword",
      "value": "SET_FROM_BACKEND_ENV"
